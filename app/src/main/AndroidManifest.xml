<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the walk detail tell whether the phone is online, so it can say the map is unavailable (AC39). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Approximate location for the weather check only (AC25). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Precise location only while a walk is recorded (AC28, ADR 0005). No background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Requested in context on Android 13 and later. Recording still runs if it is denied (ADR 0005). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DogWalkBuddyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DogWalkBuddy"
        android:usesCleartextTraffic="false">

        <!-- uiMode is handled in place, so a system light/dark switch only recomposes (AC7, ADR 0007). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WalkRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Defensive guard: the resolved profileinstaller declares no receiver today, but an
             earlier version exported ProfileInstallReceiver. The app allows no exported component
             other than the launcher, so if a later version brings it back the merger removes it.
             Lint cannot see the library class from here, hence the MissingClass suppression. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
